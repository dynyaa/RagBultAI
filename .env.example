# =============================================================================
# RAG Template Configuration
# Copy this file to .env and fill in your values:  cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# App Service
# -----------------------------------------------------------------------------

PG_CONN=postgresql://pgvector:your-db-password@pgvector:5432/ragdb_v3
OPENAI_API_KEY=sk-proj-your-openai-key
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLM_MODEL=gpt-4o-mini
DEFAULT_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
ENVIRONMENT=development
COLLECTION_NAME=user_docs
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8002

# Google OAuth (optional -- enables "Sign in with Google")
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
OAUTH_REDIRECT_URI=https://your-app.bult.app/api/auth/google/callback

NIA_API_KEY=
JWT_SECRET=change-this-to-a-random-string
ENABLE_FAITHFULNESS_SCORING=true
OCR_LANGUAGES=rus+eng+kaz

# -----------------------------------------------------------------------------
# Postgres / pgvector Service
# -----------------------------------------------------------------------------

POSTGRES_DB=ragdb_v3
POSTGRES_USER=pgvector
POSTGRES_PASSWORD=your-db-password
